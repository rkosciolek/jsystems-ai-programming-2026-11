# Copy to app/.env.local (or the repo-root .env). Never commit real values.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-6-luna
VISION_MODEL=openai/gpt-6-luna
JEV_MODEL=typesafe/jev-1.14
DECISION_MODE=auto
JEV_CONFIDENCE_THRESHOLD=0.80
LLM_REASONING_EFFORT=medium
CASE_TIMEOUT_MS=90000
CASE_TTL_MS=7200000
POLICIES_DIR=../docs/policies
DECISION_LOG_PATH=./var/decisions.jsonl
